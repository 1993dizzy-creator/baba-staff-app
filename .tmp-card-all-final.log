ionResult,cardResult,cardLineResult,cardFeeLineResult,reserveResult,reserveEntryResult,payrollResult,recurringResult,candidateResult,ownerCapacityResult,ownerInvestmentResult,ownerAllocationResult].map(result=>result.error).filter(Boolean);\n  if(errors.length) throw errors[0];\n  // Legacy fees retain their month-end date; automatic fees consume clearing on\n  // the actual finalization day, preserving the previous close\'s asset balances.\n  const [monthEndFeeLineResult, feeClosureResult] = await Promise.all([\n    loadSnapshotRows((from,to)=>supabaseServer.from("ledger_card_fee_allocation_lines").select("id,closure_id,pos_card_transaction_id,allocated_fee_amount,closure:ledger_card_fee_closures!inner(status,fee_month,finalization_business_date)").neq("closure.status","cancelled").lt("closure.fee_month",endExclusive).order("id").range(from,to)),\n    supabaseServer.from("ledger_card_fee_closures").select("id,fee_month,fee_amount,status,confirmed_at,confirmed_by,expense_transaction_id,finalization_business_date").eq("fee_month",monthStart).eq("status","confirmed").maybeSingle(),\n  ]);\n  if(monthEndFeeLineResult.error) throw monthEndFeeLineResult.error;\n  if(feeClosureResult.error) throw feeClosureResult.error;\n  const allCardFeeLines = cardFeeLineResult.data ?? [];\n  const txs=(transactionsResult.data??[]) as unknown as Tx[];\n  const recognized=txs.filter(tx=>tx.recognition_month===monthStart);\n  const cardFeeLines = allCardFeeLines.map((line): CardDifferenceLine => {\n    const sale = line.sale as unknown as {business_date:string};\n    const reconciliation = line.reconciliation as unknown as {matched_gross_amount:number|string;difference_amount:number|string};\n    return {reconciliationId:Number(line.reconciliation_id),businessDate:sale.business_date,allocatedGrossAmount:line.allocated_gross_amount,matchedGrossAmount:reconciliation.matched_gross_amount,differenceAmount:reconciliation.difference_amount};\n  });\n  const { revenue, expense, operatingResult 